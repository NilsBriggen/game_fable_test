{
  "name": "eidgenossen",
  "version": "0.2.0-phase5",
  "private": true,
  "type": "module",
  "description": "Eidgenossen — Old Swiss Confederacy RPG (browser, Three.js)",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "harness": "node tools/harness/run.mjs",
    "harness:build": "npm run build && node tools/harness/run.mjs --preview"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "playwright": "^1.49.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
